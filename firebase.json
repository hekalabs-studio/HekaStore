{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      ".git/**",
      ".vscode/**",
      "functions/**",
      "scripts/**",
      "apps-script/**",
      "*.md",
      "*.txt",
      "package-lock.json",
      "convert-images.js"
    ],
    "headers": [
      {
        "source": "/**/*.{webp,jpg,jpeg,png,gif,svg,ico}",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "max-age=86400, public"
          }
        ]
      },
      {
        "source": "/**/*.{js,css}",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, public"
          }
        ]
      },
      {
        "source": "/**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, public"
          }
        ]
      },
      {
        "source": "/index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, public"
          }
        ]
      },
      {
        "source": "/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, public"
          }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  }
}

