rules_version = '2';

// SEMENTARA — HANYA untuk sekali proses seeding lewat tools/seed-once.html
//
// Bedanya dengan firestore.rules yang asli: baris "products write" di bawah
// dibuka untuk user yang login (request.auth != null), supaya seed-once.html
// bisa menulis dari browser tanpa Node/service account key.
//
// CARA PAKAI:
//   1. firebase deploy --only firestore:rules --rules firestore.rules.seed-temp
//   2. Buka tools/seed-once.html, login, klik "Seed Produk"
//   3. SEGERA setelah selesai: firebase deploy --only firestore:rules
//      (ini akan pakai firestore.rules yang asli lagi, sesuai firebase.json)
//
// Jangan biarkan rules ini aktif lebih lama dari yang perlu — selama aktif,
// SIAPA SAJA yang berhasil bikin akun di situsmu bisa menulis/mengubah data
// produk (harga, dll).

service cloud.firestore {
  match /databases/{database}/documents {

    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null; // <-- SEMENTARA, lihat catatan di atas
    }

    match /orders/{orderId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.points == 0;
      allow update: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.points == resource.data.points;
      allow delete: if false;
    }
  }
}
