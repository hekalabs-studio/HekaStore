rules_version = '2';

// SEMENTARA — HANYA untuk sekali proses seeding lewat tools/seed-once.html
//
// Bedanya dengan firestore.rules yang asli: baris "products write" di bawah
// dibuka untuk user yang login (request.auth != null), supaya seed-once.html
// bisa menulis dari browser tanpa Node/service account key. Selebihnya
// (orders, users, pointClaims) SAMA PERSIS dengan firestore.rules yang asli,
// supaya situs tetap berfungsi normal untuk pengunjung lain selama proses
// seeding singkat berlangsung.
//
// CARA PAKAI:
//   1. firebase deploy --only firestore:rules --rules firestore.rules.seed-temp
//   2. Buka tools/seed-once.html, login, klik "Seed Produk"
//   3. SEGERA setelah selesai: firebase deploy --only firestore:rules
//      (ini akan pakai firestore.rules yang asli lagi, sesuai firebase.json)
//
// Jangan biarkan rules ini aktif lebih lama dari yang perlu — selama aktif,
// SIAPA SAJA yang berhasil bikin akun di situsmu bisa menulis/mengubah data
// produk (harga, dll).

service cloud.firestore {
  match /databases/{database}/documents {

    function productData(productId) {
      return get(/databases/$(database)/documents/products/$(productId)).data;
    }
    function cashRounded(price) {
      return math.ceil(price / 1000.0) * 1000;
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null; // <-- SEMENTARA, lihat catatan di atas
    }

    match /orders/{orderId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;

      allow create: if
        request.resource.data.keys().hasOnly([
          'invoiceId','productId','category','label','basePrice','total',
          'paymentMethod','userId','zoneId','nowa','promoCode','uid',
          'status','createdAt'
        ]) &&
        request.resource.data.invoiceId is string &&
        request.resource.data.productId is string &&
        request.resource.data.status == 'pending_confirmation' &&
        request.resource.data.paymentMethod in ['Qris', 'Cash'] &&
        request.resource.data.category == productData(request.resource.data.productId).category &&
        request.resource.data.label == productData(request.resource.data.productId).label &&
        productData(request.resource.data.productId).active == true &&
        request.resource.data.basePrice == productData(request.resource.data.productId).price &&
        request.resource.data.total == (
          request.resource.data.paymentMethod == 'Cash'
            ? cashRounded(productData(request.resource.data.productId).price)
            : productData(request.resource.data.productId).price
        ) &&
        (request.resource.data.uid == null || request.resource.data.uid == request.auth.uid) &&
        request.resource.data.userId is string && request.resource.data.userId.size() > 0 &&
        request.resource.data.nowa.matches('^[0-9]{10,15}$') &&
        request.resource.data.createdAt == request.time;

      allow update, delete: if false;
    }

    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null && request.auth.uid == uid;
      allow delete: if false;

      match /pointClaims/{orderId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow create: if
          request.auth != null && request.auth.uid == uid &&
          get(/databases/$(database)/documents/orders/$(orderId)).data.uid == uid &&
          get(/databases/$(database)/documents/orders/$(orderId)).data.status == 'completed' &&
          request.resource.data.keys().hasOnly(['points','claimedAt']) &&
          request.resource.data.points == math.floor(get(/databases/$(database)/documents/orders/$(orderId)).data.total / 10000);
        allow update, delete: if false;
      }
    }
  }
}
